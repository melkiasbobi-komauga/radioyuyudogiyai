# ==================================================================
# FILE KONFIGURASI UTAMA .HTACCESS - RADIO YUYU KOMINFO
# ==================================================================

# 1. PENGATURAN DASAR
Options +FollowSymLinks -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Deteksi Base URL otomatis (sesuaikan jika di subfolder)
    # RewriteBase /Radio-yuyu-website/

    # 2. PRETTY URL (MENGHILANGKAN EKSTENSI .PHP)
    # --------------------------------------------------------------
    
    # Kondisi 1: Jika request bukan file (-f) dan bukan direktori (-d)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # Kondisi 2: Cek apakah file .php-nya BENAR-BENAR ADA di server
    # Ini mencegah error 500 jika user mengetik URL yang file PHP-nya tidak ada
    # Variabel %{DOCUMENT_ROOT} mengambil path root server secara otomatis
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    
    # Aksi: Jika kedua kondisi di atas terpenuhi, rewrite URL tanpa ekstensi ke file .php aslinya
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

</IfModule>

# 3. KEAMANAN (SECURITY)
# ------------------------------------------------------------------
# Mencegah akses langsung ke file sensitif
<FilesMatch "\.(htaccess|htpasswd|ini|phps|fla|psd|log|sh|inc|bak|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Header Keamanan Tambahan
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# 4. ERROR HANDLING (CUSTOM 404)
# ------------------------------------------------------------------
# Mengarahkan error ke halaman custom.
# PENTING: Path harus absolut dari root domain.
# - Jika di root domain (public_html), gunakan /404.php
# - Jika di subfolder (htdocs/folder-anda), gunakan /folder-anda/404.php

ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
ErrorDocument 500 /404.php

# 5. CACHING (PERFORMA)
# ------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>
```